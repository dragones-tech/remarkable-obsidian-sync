#!/bin/bash
# Open the synced folder in Obsidian, or in the file manager as a fallback.
set -uo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=/dev/null
. "$here/_common.sh"

rmos=$(resolve_rmos)
vault=$("$rmos" config get obsidian.vault --json 2>/dev/null | jq -r '.value // empty')
source_dir=$("$rmos" config get obsidian.source --json 2>/dev/null | jq -r '.value // empty')
[[ -n $vault ]] || die_json "No vault configured. Run: rmos init-config --vault <path>"
target="${vault/#\~/$HOME}/${source_dir:-Sources/reMarkable}"

if command -v xdg-open >/dev/null 2>&1; then
  xdg-open "obsidian://open?path=$(jq -rn --arg p "$target" '$p|@uri')" >/dev/null 2>&1 \
    || xdg-open "$target" >/dev/null 2>&1 &
fi
emit --arg path "$target" '{ok: true, path: $path}'
